+def _omit_repeated_text_type(schema):
+    # An implicit type is unambiguous only if every actual column is typed.
+    # Fall back on unfamiliar declarations and preserve quoted text/comments.
+    if '--' in schema or '/*' in schema:
+        return schema, False
